<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Native PDFium binary flows to every project that references this one (app, tests). -->
  <ItemGroup>
    <None Include="..\..\native\pdfium\win-x64\pdfium.dll" Link="pdfium.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
