<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LightPdf.App.MainWindow"
        Title="LightPdf" Width="1000" Height="800" Icon="/Assets/app.ico"
        DragDrop.AllowDrop="True">
    <Window.Styles>
        <!-- Toolbar buttons never take focus, so Space/arrows keep scrolling the document. -->
        <Style Selector="StackPanel#Toolbar > Button, StackPanel#Toolbar > ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel#Toolbar > Separator">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <!-- Compact tabs (Fluent's default tab header is 24pt text). -->
        <Style Selector="TabControl#Tabs">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="TabControl#Tabs TabItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,0,6,0" />
        </Style>
        <Style Selector="Button.tabClose">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.recentLink">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <StackPanel x:Name="Toolbar" DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="8,6">
            <Button Content="Open…" Click="OnOpenClick" ToolTip.Tip="Open (Ctrl+O)" />
            <Button x:Name="RecentButton" Content="Recent ▾" ToolTip.Tip="Recently opened files">
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft" />
                </Button.Flyout>
            </Button>
            <Button x:Name="PrintButton" Content="Print…" Click="OnPrintClick" IsEnabled="False" ToolTip.Tip="Print (Ctrl+P)" />
            <Separator />
            <Button x:Name="PrevButton" Content="▲" Click="OnPrevClick" IsEnabled="False" ToolTip.Tip="Previous page" />
            <TextBox x:Name="PageBox" Width="56" TextAlignment="Center" VerticalAlignment="Center"
                     IsEnabled="False" ToolTip.Tip="Go to page (Ctrl+G)" />
            <TextBlock x:Name="PageCountText" VerticalAlignment="Center" Text="/ 0" MinWidth="40" />
            <Button x:Name="NextButton" Content="▼" Click="OnNextClick" IsEnabled="False" ToolTip.Tip="Next page" />
            <Separator />
            <Button x:Name="ZoomOutButton" Content="−" Click="OnZoomOutClick" ToolTip.Tip="Zoom out (Ctrl+−)" />
            <TextBlock x:Name="ZoomText" VerticalAlignment="Center" MinWidth="48" TextAlignment="Center" />
            <Button x:Name="ZoomInButton" Content="+" Click="OnZoomInClick" ToolTip.Tip="Zoom in (Ctrl++)" />
            <ToggleButton x:Name="FitWidthButton" Content="Fit width" Click="OnFitWidthClick" ToolTip.Tip="Fit width (Ctrl+2)" />
            <ToggleButton x:Name="FitPageButton" Content="Fit page" Click="OnFitPageClick" ToolTip.Tip="Fit page (Ctrl+0)" />
            <Separator />
            <Button x:Name="MoreButton" Content="⋮" ToolTip.Tip="More">
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <MenuItem Header="Make LightPdf the default PDF app…" Click="OnMakeDefaultClick" />
                        <MenuItem Header="Remove LightPdf from “Open with”" Click="OnUnregisterClick" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="8,0" Opacity="0.7" />
            <Button x:Name="CancelPrintButton" Content="Cancel printing" Click="OnCancelPrintClick" IsVisible="False" />
        </StackPanel>

        <!-- Find bar (Ctrl+F). -->
        <Border x:Name="SearchBar" DockPanel.Dock="Top" IsVisible="False" Padding="8,4" Background="#262626">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBox x:Name="SearchBox" Width="260" PlaceholderText="Find in document" VerticalAlignment="Center" />
                <Button Content="▲" Click="OnSearchPrevClick" Focusable="False" ToolTip.Tip="Previous match (Shift+Enter, Shift+F3)" />
                <Button Content="▼" Click="OnSearchNextClick" Focusable="False" ToolTip.Tip="Next match (Enter, F3)" />
                <ToggleButton x:Name="MatchCaseButton" Content="Aa" Click="OnMatchCaseClick" Focusable="False" ToolTip.Tip="Match case" />
                <TextBlock x:Name="SearchStatus" VerticalAlignment="Center" MinWidth="110" Margin="6,0" />
                <Button Content="✕" Click="OnSearchCloseClick" Focusable="False" ToolTip.Tip="Close (Esc)" />
            </StackPanel>
        </Border>

        <Grid>
            <TabControl x:Name="Tabs" IsVisible="False" SelectionChanged="OnTabSelectionChanged" />

            <!-- Shown when no document is open. -->
            <Border x:Name="EmptyState" Background="#3a3a3a">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Width="420">
                    <TextBlock Text="Open a PDF" FontSize="24" HorizontalAlignment="Center" Foreground="White" />
                    <TextBlock Text="Ctrl+O, or drop files anywhere in this window" HorizontalAlignment="Center"
                               Foreground="#c8c8c8" />
                    <TextBlock x:Name="RecentHeading" Text="Recent" FontWeight="SemiBold" Margin="0,16,0,0"
                               Foreground="#c8c8c8" />
                    <StackPanel x:Name="RecentList" Spacing="2" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
