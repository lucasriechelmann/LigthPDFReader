<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon> <!-- exe icon (Explorer, taskbar pin, Default apps) -->
    <AssemblyName>LightPdf</AssemblyName>
    <RootNamespace>LightPdf.App</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks> <!-- source-generated P/Invoke for Win32 printing -->

    <!-- Native AOT: one self-contained exe, no JIT, fast startup. -->
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LightPdf.Core\LightPdf.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window/taskbar icon, loaded by Avalonia. -->
    <AvaloniaResource Include="Assets\app.ico" />
    <!-- Icon for .pdf files once associated (registry DefaultIcon points at this file). -->
    <None Include="Assets\pdf-document.ico" Link="pdf-document.ico"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
