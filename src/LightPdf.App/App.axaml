<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LightPdf.App.App"
             RequestedThemeVariant="Default">
    <!-- "Default" follows Windows' light/dark app setting; the ⋮ menu can force Light or Dark. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ViewerBackdrop" Color="#D9DCE1" />
                    <SolidColorBrush x:Key="BarBackground" Color="#ECEEF1" />
                    <SolidColorBrush x:Key="PrimaryText" Color="#1F2328" />
                    <SolidColorBrush x:Key="SecondaryText" Color="#59636E" />
                    <SolidColorBrush x:Key="MessageBackground" Color="#FFF4CE" />
                    <SolidColorBrush x:Key="MessageForeground" Color="#5C4300" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ViewerBackdrop" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="BarBackground" Color="#262626" />
                    <SolidColorBrush x:Key="PrimaryText" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SecondaryText" Color="#C8C8C8" />
                    <SolidColorBrush x:Key="MessageBackground" Color="#433519" />
                    <SolidColorBrush x:Key="MessageForeground" Color="#FCE8B2" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
